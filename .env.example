# Environment variables; the app does not automatically load this file.
# PORT binds to all interfaces. Without PORT or ADDR, use 127.0.0.1:8080.
PORT=8080
# Optional full listen address; overrides PORT when both are set.
# ADDR=127.0.0.1:8080
DATA_DIR=data
# Read web/ assets from disk and disable PWA caching during development.
# DEBUG=1

# Public OSM Shortbread v1 vector tiles: no account or API key.
TILE_URL=https://vector.openstreetmap.org/shortbread_v1/{z}/{x}/{y}.mvt

# Override only for a compatible provider or local integration fixtures.
FORECAST_URL=https://api.open-meteo.com/v1/dwd-icon
SEARCH_URL=https://geocoding-api.open-meteo.com/v1/search
OBSERVATIONS_URL=https://opendata.dwd.de/weather/weather_reports/synoptic/germany/geojson/
METAR_URL=https://aviationweather.gov/api/data/metar
METAR_CACHE_URL=https://aviationweather.gov/data/cache/metars.cache.csv.gz
